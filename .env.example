# Copie para .env.local e preencha com os dados do projeto Supabase DA FAZENDA
# (Supabase → Project Settings → Data API / API Keys).
# No Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# Sem elas o app roda em "modo demonstração": tudo fica só neste aparelho.
#
# Tudo que começa com VITE_ vai para o navegador: nunca coloque aqui a
# service_role key nem senhas do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
